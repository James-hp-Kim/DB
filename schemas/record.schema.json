{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expert Hub knowledge record v2",
  "type": "object",
  "required": ["id", "title", "summary", "track", "tags", "source_ids", "evidence_level", "reviewed", "implementation", "sections"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}:[a-z0-9][a-z0-9-]{0,95}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 180},
    "summary": {"type": "string", "minLength": 1, "maxLength": 500},
    "track": {"enum": ["quick", "deep", "both"]},
    "tags": {"type": "array", "minItems": 1, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 100}},
    "source_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}},
    "evidence_level": {"type": "string", "minLength": 1, "maxLength": 80},
    "reviewed": {"type": "string", "minLength": 1, "maxLength": 50},
    "implementation": {"type": "string", "minLength": 1, "maxLength": 200},
    "sections": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "conditions": {"type": "string", "minLength": 1},
        "procedure": {"type": "string", "minLength": 1},
        "interpretation": {"type": "string", "minLength": 1},
        "verification": {"type": "string", "minLength": 1},
        "limits": {"type": "string", "minLength": 1},
        "detail": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Expert Hub persona catalog",
  "type": "object",
  "minProperties": 1,
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9-]{0,63}$"
  },
  "additionalProperties": {
    "type": "object",
    "required": [
      "label",
      "role",
      "keywords",
      "default_packs",
      "allowed_packs"
    ],
    "additionalProperties": false,
    "properties": {
      "label": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      },
      "role": {
        "type": "string",
        "minLength": 1,
        "maxLength": 900
      },
      "keywords": {
        "type": "array",
        "minItems": 1,
        "maxItems": 30,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "default_packs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "not": {
            "const": "private"
          }
        }
      },
      "allowed_packs": {
        "type": "array",
        "minItems": 1,
        "maxItems": 12,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "not": {
            "const": "private"
          }
        }
      }
    }
  }
}

    {
      "name": "M02_signed_compare",
      "reason": "Signed less-than incorrectly uses unsigned comparison",
      "old": "$signed(reg_op1) < $signed(reg_op2)",
      "new": "reg_op1 < reg_op2",
      "occurrences": 2,
      "repaired_text_equals_original": true
    },
    {
      "name": "M03_and_as_or",
      "reason": "AND decoded datapath incorrectly computes OR",
      "old": "alu_out = reg_op1 & reg_op2;",
